{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "co.gemina/filetag",
  "title": "Gemina FileTag",
  "description": "Superseded by co.gemina/gemina — same server, new name. Install co.gemina/gemina.",
  "version": "1.0.3",
  "icons": [
    {
      "src": "https://www.gemina.co/assets/filetag-logo.png",
      "sizes": ["400x400"],
      "mimeType": "image/png"
    }
  ],
  "repository": {
    "url": "https://github.com/tommyil/gemina-mcp",
    "source": "github"
  },
  "websiteUrl": "https://www.gemina.co/product/agents",
  "documentationUrl": "https://github.com/tommyil/gemina-mcp#readme",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.gemina.co/api/v1/mcp/",
      "headers": [
        {
          "name": "X-API-Key",
          "description": "Optional. Omit to sign in with OAuth 2.1 (Claude Code /mcp, claude.ai connectors). Get a key at https://console.gemina.co/api-keys",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
